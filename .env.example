# Copy to api/.env and fill in. Never commit the real file.

PEHCHAAN_ENV=dev
# Comma-separated API keys accepted in the X-API-Key header
PEHCHAAN_API_KEYS=change-me-dev-key
# Secret for keyed ID-number hashes (duplicate detection). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PEHCHAAN_ID_HASH_PEPPER=
PEHCHAAN_CORS_ORIGINS=http://localhost:5173

# Textract (existing Hackingly pipeline); keep data in India
PEHCHAAN_TEXTRACT_ENABLED=false
PEHCHAAN_AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# UIDAI offline verification certificate (download from uidai.gov.in on an Indian network)
PEHCHAAN_UIDAI_CERT_PATH=certs/uidai_offline_publickey.cer

# Reviewer copilot / college-ID extraction (optional)
PEHCHAAN_LLM_PROVIDER=none
GROQ_API_KEY=

PEHCHAAN_IMAGE_RETENTION_DAYS=30
