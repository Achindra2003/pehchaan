# Copy to api/.env and fill in. Never commit the real file.

PEHCHAAN_ENV=dev
# key:tenant:role, comma-separated. Roles: platform (Hackingly backend), reviewer (organiser staff), admin.
PEHCHAAN_API_KEYS=change-me-platform:hackingly:platform,change-me-reviewer:hackingly:reviewer,change-me-admin:hackingly:admin
PEHCHAAN_RATE_LIMIT_PER_MINUTE=120
PEHCHAAN_PUBLIC_BASE_URL=http://localhost:8000
PEHCHAAN_CORS_ORIGINS=http://localhost:5173

# Secrets (required in prod; generated into data/dev-secrets.json in dev)
#   data key:    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   pepper:      python -c "import secrets; print(secrets.token_urlsafe(32))"
#   signing key: EC P-256 private key PEM (passes and OpenID4VP request objects)
PEHCHAAN_DATA_KEY=
PEHCHAAN_ID_HASH_PEPPER=
PEHCHAAN_SIGNING_KEY=

# Privacy
PEHCHAAN_REQUIRE_CONSENT=true
PEHCHAAN_IMAGE_STORAGE=review_only
PEHCHAAN_IMAGE_RETENTION_DAYS=30
PEHCHAAN_PASS_VALIDITY_DAYS=365

# Throughput (scale out with processes/containers; see scripts/loadtest.py)
PEHCHAAN_WORKERS=2
PEHCHAAN_QUEUE_SIZE=200

# OCR: Hackingly's Textract JSON is used when sent; otherwise live Textract or local RapidOCR
PEHCHAAN_OCR_PROVIDER=auto
PEHCHAAN_TEXTRACT_ENABLED=false
PEHCHAAN_AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# UIDAI trust anchors (download on an Indian network)
PEHCHAAN_UIDAI_CERT_PATH=certs
PEHCHAAN_UIDAI_JWKS_PATH=certs/uidai-jwks.json
PEHCHAAN_VERIFIER_CLIENT_ID=pehchaan-ovse

# Reviewer copilot (optional; rules-based summary otherwise)
PEHCHAAN_LLM_PROVIDER=none
PEHCHAAN_GROQ_API_KEY=

# Webhooks to Hackingly (HMAC-SHA256 over "timestamp.body")
PEHCHAAN_WEBHOOK_URL=
PEHCHAAN_WEBHOOK_SECRET=
